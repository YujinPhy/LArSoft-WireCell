#include "services_dune.fcl"
#include "services_vdcoldbox.fcl"

# Reusable outputer (wclsFrameSaver) lists per detector/config. The list used
# by an nfsp block MUST match its jsonnet process_mode (see each file's header).
#include "wirecell_dune-vd.fcl"
#include "wirecell_dune10kt-vd.fcl"

BEGIN_PROLOG

wirecell_protodunevd_sim_deposplat:
{
    module_type : WireCellToolkit
    wcls_main: {
        tool_type: WCLS

        logsinks: ["stdout"]
        loglevels: ["debug", "pgraph:info"]
        apps: ["Pgrapher"]
        plugins: ["WireCellPgraph", "WireCellGen","WireCellSio","WireCellSigProc","WireCellRoot","WireCellLarsoft","WireCellHio","WireCellTbb","WireCellImg","WireCellPytorch"]
        configs: ["/nfs/data/1/yujin/LArSoft-WireCell/fcl_sim/wcls-sim-drift-deposplat.jsonnet"]
        inputers: ["wclsSimDepoSource:"]
        outputers: [
            // "wclsSimChannelSink:postdrift",
            // "wclsFrameSaver:simdigits"
        ]
        params: {
        }
	structs: {
        Nbit: @local::Nbit_standard 
        elecGain:    14 # probably not, will  have to change
        nticks: @local::protodunevd_services.DetectorPropertiesService.NumberTimeSamples
        lifetime: @local::protodunevd_services.DetectorPropertiesService.Electronlifetime
        DL: @local::dunefd_largeantparameters.LongitudinalDiffusion
        DT: @local::dunefd_largeantparameters.TransverseDiffusion
        efield: @local::protodunevd_services.DetectorPropertiesService.Efield[0] # kV/cm
        temperature: @local::protodunevd_services.DetectorPropertiesService.Temperature # K
	}
    }
}

END_PROLOG